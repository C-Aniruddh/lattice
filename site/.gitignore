# `site/data/*.json` and `site/example/hello.ts`; these four are outputs and are never edited.
# Committing them would give a reviewer two sources of truth for the API reference, which is the
# exact drift the generator exists to prevent.
/index.html
/public/llms.txt
/public/api.json
/public/kit.json

# `dist/` is already covered by the repository's own .gitignore. Named here as well because this
# directory is not a workspace member and a reader of `site/` alone should not have to go looking.
/dist/
