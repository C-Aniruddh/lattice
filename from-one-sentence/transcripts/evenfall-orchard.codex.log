+<!doctype html>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
+<title>Evenfall Orchard</title>
+<style>
+  :root { font-family: Inter, ui-rounded, system-ui, sans-serif; color: #fff8e9; }
+  * { box-sizing: border-box; }
+  html, body { margin: 0; height: 100%; overflow: hidden; background: #18231f; overscroll-behavior: none; }
+  #app { position: fixed; inset: 0; }
+  canvas { display: block; width: 100%; height: 100%; }
+  .hud { position: fixed; inset: 0; pointer-events: none; padding: clamp(14px,3vw,28px); display:flex; flex-direction:column; justify-content:space-between; }
+  .top { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; }
+  .brand, .card { background: rgba(38,34,25,.86); border:1px solid rgba(255,239,199,.22); box-shadow:0 12px 36px rgba(13,18,14,.28); backdrop-filter:blur(12px); }
+  .brand { padding:13px 17px; border-radius:18px; }
+  .brand h1 { font:700 clamp(18px,3vw,27px)/1 Georgia,serif; margin:0 0 6px; color:#ffe6a3; }
+  .brand p, .card p { margin:0; color:#d9d4bd; font-size:13px; }
+  .stats { display:flex; gap:8px; flex-wrap:wrap; justify-content:flex-end; }
+  .pill { background:rgba(38,34,25,.88); border:1px solid rgba(255,239,199,.2); border-radius:999px; padding:9px 13px; font-weight:700; }
+  .pill small { color:#c7bea5; font-weight:500; margin-right:5px; }
+  .bottom { display:flex; align-items:flex-end; justify-content:space-between; gap:16px; }
+  .card { padding:14px 16px; border-radius:18px; max-width:360px; }
+  .card strong { display:block; color:#ffe6a3; margin-bottom:5px; }
+  button { pointer-events:auto; border:0; border-radius:14px; padding:13px 18px; font:700 15px inherit; color:#33291e; background:#ffd778; box-shadow:0 6px 0 #b87442,0 10px 24px rgba(0,0,0,.22); cursor:pointer; transition:transform .15s,filter .15s; }
+  button:hover { filter:brightness(1.06); transform:translateY(-1px); }
+  button:active { transform:translateY(4px); box-shadow:0 2px 0 #b87442; }
+  button:disabled { opacity:.48; filter:grayscale(.5); cursor:not-allowed; }
+  .evening { position:fixed; inset:0; display:none; place-items:center; background:rgba(14,18,25,.48); backdrop-filter:blur(5px); pointer-events:auto; padding:20px; }
+  .evening.open { display:grid; }
+  .dialog { width:min(480px,100%); text-align:center; padding:28px; border-radius:26px; background:#302b28; border:1px solid #786450; box-shadow:0 24px 80px rgba(0,0,0,.45); }
+  .moon { font-size:40px; }
+  .dialog h2 { font:700 29px/1.1 Georgia,serif; color:#ffe5a5; margin:8px 0; }
+  .dialog p { color:#d7cebc; line-height:1.5; margin:0 0 20px; }
+  .choices { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
+  .choices button:last-child { background:#b8d99d; box-shadow:0 6px 0 #628359; }
+  .toast { position:fixed; left:50%; bottom:95px; translate:-50% 20px; opacity:0; background:#fff2c9; color:#423323; padding:11px 16px; border-radius:999px; font-weight:700; transition:.25s; pointer-events:none; }
+  .toast.show { opacity:1; translate:-50% 0; }
+  @media(max-width:620px){ .top{flex-direction:column}.stats{justify-content:flex-start}.bottom{align-items:stretch}.card{display:none}.choices{grid-template-columns:1fr} }
+</style>
+<div id="app"></div>
+<script type="module" src="/src/main.ts"></script>
