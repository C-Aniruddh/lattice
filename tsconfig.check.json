{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@latticekit/*": [
        "packages/*/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/*/test/**/*",
    "packages/*/src/**/*",
    "examples/*/src/**/*",
    "examples/*/test/**/*",
    "tools/**/*"
  ]
}
